# =============================================
# Healthcare Platform - Backend Environment
# Copy this file to .env and adjust values.
# =============================================

# Server
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# JWT
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# Database (XAMPP MariaDB defaults: root / no password on 3306)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=healthcare_platform
DB_CONNECTION_LIMIT=10

# AES-256 encryption for sensitive field-at-rest encryption
# Must be exactly 32 characters for AES-256.
DATA_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# Security
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Sensor API key (used for /api/sensors/:token ingestion)
SENSOR_API_KEY=dev-sensor-key-123

# Default admin account created by the seed script
SEED_ADMIN_EMAIL=admin@healthcare.local
SEED_ADMIN_PASSWORD=Admin123!
